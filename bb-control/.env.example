# Conexión a Postgres (Supabase: Project Settings > Database > Connection string > Session pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Contraseña del panel de administración
ADMIN_PASSWORD=
# 32 caracteres o más, al azar (firma las cookies de sesión)
SESSION_SECRET=
